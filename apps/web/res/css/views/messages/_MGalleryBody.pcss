.mx_MGalleryBody {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--cpd-space-1x);
    max-width: 480px;

    /* a lone item uses the full width */
    &[data-count="1"] {
        grid-template-columns: minmax(0, 1fr);
    }
}

.mx_MGalleryBody_item {
    min-width: 0;
    overflow: hidden;
    border-radius: var(--cpd-space-2x);
}

/* With several items, crop images and videos to fill an even tile (the sizes they set themselves are inline) */
.mx_MGalleryBody:not([data-count="1"]) .mx_MGalleryBody_item {
    .mx_ImageBody_container,
    .mx_MVideoBody_container {
        width: 100% !important;
        height: auto !important;
        max-width: none !important;
        max-height: none !important;
        aspect-ratio: 1 !important;
    }

    .mx_ImageBody_container > *,
    .mx_MVideoBody_container > *,
    .mx_ImageBody_image,
    .mx_MVideoBody {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    /* an odd item left over on the last row spans the full width */
    &:last-child:nth-child(odd) {
        grid-column: span 2;

        .mx_ImageBody_container,
        .mx_MVideoBody_container {
            aspect-ratio: 2 !important;
        }
    }
}
